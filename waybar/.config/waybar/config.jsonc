[
	{
		"reload_style_on_change":true,

		"output": "DP-2",
		"layer": "top",
		"position": "top",
		"height": "32",
		"spacing": 4,
		"margin-top": 0,
		"margin-bottom": 0,
		"passthrough": false,
		
		"modules-left": [
			"sway/workspaces",
			"sway/mode"
		],
		"modules-center": [
			"sway/window"
		],
		"modules-right": [
			"wireplumber",
			"network",
			"clock"
		],

		"sway/workspaces": {
			"all-outputs": true,
			"disable-scroll": false,
			"format": "{name}"
		},

		"sway/window": {
			"all-outputs": false,
			"max-length": 60,
			"tooltip": false
		},
		"wireplumber": {
			// "scroll-step": 1, // %, can be a float
			"format": "{volume}% {icon}",
			"format-bluetooth": "{volume}% {icon}",
			"format-bluetooth-muted": " {icon}",
			"format-muted": "-%  ",
			"format-source": "{volume}% ",
			"format-source-muted": "",
			"format-icons": {
				"headphone": "",
				"hands-free": "",
				"headset": "",
				"phone": "",
				"portable": "",
				"car": "",
				"default": ["", "", ""]
			},
			"on-click": "pavucontrol",
			"max-volume": 100
		},
		"network": {
			// "interface": "wlp2*", // (Optional) To force the use of this interface
			"format-wifi": "{essid}  ",
			"format-ethernet": "{ipaddr}/{cidr} ",
			"tooltip-format": "{ifname} via {gwaddr} ",
			"format-linked": "{ifname} (No IP) ",
			"format-disconnected": "Disconnected ⚠",
			//"format-alt": "{ifname}: {ipaddr}/{cidr}",
			"on-click": "~/.config/fuzzel/scripts/wifi_menu.sh"
		},
		"clock": {
			// "timezone": "America/New_York",
			"format": "{:%H:%M, %a %d %b}",
			"format-alt": "{:%Y-%m-%d}"
		}
	},
	{
		"reload_style_on_change":true,

		"output": "HDMI-A-1",
		"layer": "top",
		"position": "top",
		"height": "32",
		"spacing": 4,
		"margin-top": 0,
		"margin-bottom": 0,
		"passthrough": false,
		
		"modules-left": [
			"sway/workspaces",
			"sway/mode"
		],
		"modules-center": [
			"sway/window"
		],
		"modules-right": [
			"wireplumber",
			"network",
			"clock"
		],

		"sway/workspaces": {
			"all-outputs": true,
			"disable-scroll": false,
			"format": "{name}"
		},

		"sway/window": {
			"all-outputs": false,
			"max-length": 60,
			"tooltip": false
		},
		"wireplumber": {
			// "scroll-step": 1, // %, can be a float
			"format": "{volume}% {icon}",
			"format-bluetooth": "{volume}% {icon}",
			"format-bluetooth-muted": " {icon}",
			"format-muted": "-%  ",
			"format-source": "{volume}% ",
			"format-source-muted": "",
			"format-icons": {
				"headphone": "",
				"hands-free": "",
				"headset": "",
				"phone": "",
				"portable": "",
				"car": "",
				"default": ["", "", ""]
			},
			"on-click": "pavucontrol",
			"max-volume": 100
		},
		"network": {
			// "interface": "wlp2*", // (Optional) To force the use of this interface
			"format-wifi": "{essid}  ",
			"format-ethernet": "{ipaddr}/{cidr} ",
			"tooltip-format": "{ifname} via {gwaddr} ",
			"format-linked": "{ifname} (No IP) ",
			"format-disconnected": "Disconnected ⚠",
			//"format-alt": "{ifname}: {ipaddr}/{cidr}",
			"on-click": "~/.config/fuzzel/scripts/wifi_menu.sh"
		},
		"clock": {
			// "timezone": "America/New_York",
			"format": "{:%H:%M, %a %d %b}",
			"format-alt": "{:%Y-%m-%d}"
		}
	}
]
